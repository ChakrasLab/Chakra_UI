{
  "name": "chakra-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/docs",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @chakra/docs",
    "build": "tsc --noEmit && npm run build --workspace @chakra/docs",
    "preview": "npm run preview --workspace @chakra/docs"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  }
}
