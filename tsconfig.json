{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@chakra/icons": ["./packages/icons/src/index.ts"],
      "@chakra/react": ["./packages/react/src/index.ts"],
      "@chakra/tokens": ["./packages/tokens/src/index.css"]
    },
    "types": ["vite/client"]
  },
  "include": ["apps/docs/src", "packages/icons/src", "packages/react/src", "vite.config.ts"]
}
